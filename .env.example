# Secret passcode for site access (Default: memory2026 - change to your private key)
SITE_PASSCODE=memory2026

# JWT Secret key used for signing session tokens (Change to a random secret string in production)
JWT_SECRET=super_secret_session_token_key_change_me_in_prod

# Recipient & Sender personalization across the app
NEXT_PUBLIC_RECIPIENT_NAME=RecipientName
NEXT_PUBLIC_RECIPIENT_NICKNAME=RecipientNickname
NEXT_PUBLIC_SENDER_NAME=SenderName
